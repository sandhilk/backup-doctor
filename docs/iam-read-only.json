{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupDoctorListBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-shop-backups",
      "Condition": { "StringLike": { "s3:prefix": ["postgres/*"] } }
    },
    {
      "Sid": "BackupDoctorReadBackups",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-shop-backups/postgres/*"
    }
  ]
}
